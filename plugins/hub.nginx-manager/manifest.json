{
  "id": "hub.nginx-manager",
  "name": {
    "zh-Hans": "Nginx 管理",
    "en": "Nginx Manager"
  },
  "description": {
    "zh-Hans": "配置检查 / 版本 / 状态 / 重载 / 访问日志。重载前请先点一次「检查配置」，配置有语法错误时重载会让服务异常。",
    "en": "Config test, version, status, reload and the access log. Run \"Test config\" before reloading — a broken config can take the service down."
  },
  "version": "3.1.1",
  "engine": "dsl/1",
  "minAppVersion": "0.11.8",
  "author": {
    "name": "ServerDeck Hub"
  },
  "license": "MIT",
  "categories": [
    "ops",
    "web"
  ],
  "permissions": [
    "ssh.exec",
    "ui.page",
    "sftp.read"
  ],
  "scope": {
    "ssh.exec.allow": [
      {
        "id": "nginx_test",
        "exec": [
          "nginx",
          "-t"
        ],
        "timeout": "10s",
        "description": "检查配置文件语法（结果在 stderr）"
      },
      {
        "id": "nginx_reload",
        "exec": [
          "nginx",
          "-s",
          "reload"
        ],
        "timeout": "15s"
      },
      {
        "id": "nginx_version",
        "exec": [
          "nginx",
          "-v"
        ],
        "timeout": "10s"
      },
      {
        "id": "nginx_service_status",
        "exec": [
          "systemctl",
          "is-active",
          "nginx"
        ],
        "timeout": "10s"
      },
      {
        "id": "nginx_tail_access",
        "exec": [
          "tail",
          "-n",
          "{{lines}}",
          "{{path}}"
        ],
        "vars": {
          "lines": {
            "type": "enumeration",
            "values": [
              "20",
              "50",
              "100",
              "200"
            ],
            "required": true
          },
          "path": {
            "type": "path",
            "required": true,
            "description": "访问日志文件路径"
          }
        },
        "timeout": "15s"
      }
    ]
  },
  "contributes": {
    "pages": [
      {
        "id": "main",
        "title": {
          "zh-Hans": "Nginx 管理",
          "en": "Nginx Manager"
        },
        "entry": "pages/main.json",
        "showIn": [
          "drawer"
        ]
      }
    ]
  }
}