{
  "id": "hub.pm2-manager",
  "name": {
    "zh-Hans": "PM2 管理",
    "en": "PM2 Manager"
  },
  "description": {
    "zh-Hans": "管理 Node.js 常驻进程：列表、重启、停止、删除。所有命令都落在白名单模板里，且危险操作默认带二次确认。",
    "en": "Manages Node.js daemons: list, restart, stop, delete. Every command is a whitelisted template and destructive actions ask for confirmation."
  },
  "version": "3.0.0",
  "engine": "dsl/1",
  "minAppVersion": "1.0.0",
  "author": {
    "name": "ServerDeck Hub"
  },
  "license": "MIT",
  "categories": [
    "ops",
    "runtime"
  ],
  "permissions": [
    "ssh.exec",
    "ui.page",
    "ui.homeWidget"
  ],
  "scope": {
    "ssh.exec.allow": [
      {
        "id": "pm2_list",
        "exec": [
          "pm2",
          "jlist"
        ],
        "timeout": "20s",
        "description": "全部 PM2 应用的 JSON（客户端解析）"
      },
      {
        "id": "pm2_restart",
        "exec": [
          "pm2",
          "restart",
          "{{app}}"
        ],
        "vars": {
          "app": {
            "type": "string",
            "required": true,
            "description": "PM2 应用名或 id"
          }
        },
        "timeout": "30s"
      },
      {
        "id": "pm2_stop",
        "exec": [
          "pm2",
          "stop",
          "{{app}}"
        ],
        "vars": {
          "app": {
            "type": "string",
            "required": true,
            "description": "PM2 应用名或 id"
          }
        },
        "timeout": "30s"
      },
      {
        "id": "pm2_delete",
        "exec": [
          "pm2",
          "delete",
          "{{app}}"
        ],
        "vars": {
          "app": {
            "type": "string",
            "required": true,
            "description": "PM2 应用名或 id"
          }
        },
        "timeout": "30s"
      }
    ]
  },
  "contributes": {
    "pages": [
      {
        "id": "main",
        "title": {
          "zh-Hans": "PM2 管理",
          "en": "PM2 Manager"
        },
        "entry": "pages/main.json",
        "showIn": [
          "drawer"
        ]
      }
    ]
  }
}