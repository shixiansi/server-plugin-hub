{
  "engine": "dsl/1",
  "root": {
    "type": "column",
    "gap": "md",
    "children": [
      {
        "type": "dataSource",
        "key": "apps",
        "capability": "ssh.exec",
        "parse": "json",
        "args": {
          "template": "pm2_list"
        }
      },
      {
        "type": "card",
        "title": {
          "zh-Hans": "应用列表",
          "en": "Apps"
        },
        "children": [
          {
            "type": "when",
            "cond": "{{data.apps.ok}}",
            "then": [
              {
                "type": "when",
                "cond": "{{data.apps.parsed}}",
                "then": [
                  {
                    "type": "text",
                    "value": "Total: {{data.apps.count}}",
                    "color": "secondary"
                  },
                  {
                    "type": "forEach",
                    "list": "{{data.apps.json}}",
                    "item": "app",
                    "emptyText": "No PM2 apps found.",
                    "template": {
                      "type": "listItem",
                      "icon": "memory",
                      "title": "{{item.name}}",
                      "badge": "{{item.pm2_env.status}}",
                      "subtitle": {
                        "op": "concat",
                        "args": [
                          "pid ",
                          {
                            "ref": "item.pid"
                          },
                          " · cpu ",
                          {
                            "ref": "item.monit.cpu"
                          },
                          "% · ",
                          {
                            "op": "formatBytes",
                            "args": [
                              {
                                "ref": "item.monit.memory"
                              }
                            ]
                          }
                        ]
                      },
                      "actions": [
                        {
                          "label": "重启",
                          "icon": "restart",
                          "onTap": {
                            "action": "run",
                            "template": "pm2_restart",
                            "args": {
                              "app": "{{item.name}}"
                            }
                          }
                        },
                        {
                          "label": "停止",
                          "icon": "stop",
                          "style": "danger",
                          "confirm": true,
                          "onTap": {
                            "action": "run",
                            "template": "pm2_stop",
                            "args": {
                              "app": "{{item.name}}"
                            }
                          }
                        },
                        {
                          "label": "删除",
                          "icon": "delete",
                          "style": "danger",
                          "confirm": true,
                          "onTap": {
                            "action": "run",
                            "template": "pm2_delete",
                            "args": {
                              "app": "{{item.name}}"
                            }
                          }
                        }
                      ]
                    }
                  }
                ],
                "else": [
                  {
                    "type": "text",
                    "value": "parse failed: {{data.apps.parseError}}",
                    "mono": true,
                    "maxLines": 3,
                    "color": "secondary"
                  },
                  {
                    "type": "text",
                    "value": "truncated: {{data.apps.truncated}} · bytes: {{data.apps.stdout}}",
                    "mono": true,
                    "maxLines": 6,
                    "color": "secondary"
                  }
                ]
              }
            ],
            "else": [
              {
                "type": "errorView",
                "title": {
                  "zh-Hans": "读不到 PM2 列表",
                  "en": "Cannot read PM2 list"
                },
                "description": {
                  "zh-Hans": "请确认服务器上装有 pm2，且当前用户在 pm2 的进程列表里。（错误：{{data.apps.message}}）",
                  "en": "Make sure pm2 is installed and the current user owns the pm2 daemon. (Error: {{data.apps.message}})"
                }
              }
            ]
          }
        ]
      },
      {
        "type": "card",
        "title": {
          "zh-Hans": "操作提示",
          "en": "How to act"
        },
        "children": [
          {
            "type": "text",
            "value": "Left-swipe an app row to restart / stop / delete it.",
            "color": "secondary"
          },
          {
            "type": "button",
            "label": {
              "zh-Hans": "刷新列表",
              "en": "Refresh"
            },
            "onTap": {
              "action": "refresh"
            },
            "style": "tonal"
          }
        ]
      }
    ]
  }
}