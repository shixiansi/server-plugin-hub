{
  "engine": "dsl/1",
  "root": {
    "type": "column",
    "gap": "md",
    "children": [
      {
        "type": "dataSource",
        "key": "containers",
        "capability": "ssh.exec",
        "parse": "json",
        "args": {
          "template": "docker_ps"
        }
      },
      {
        "type": "card",
        "title": {
          "zh-Hans": "容器",
          "en": "Containers"
        },
        "children": [
          {
            "type": "when",
            "cond": "{{data.containers.parsed}}",
            "then": [
              {
                "type": "text",
                "value": "Total: {{data.containers.count}}",
                "color": "secondary"
              },
              {
                "type": "forEach",
                "list": "{{data.containers.json}}",
                "item": "c",
                "emptyText": "No containers.",
                "template": {
                  "type": "listItem",
                  "icon": "deployed_code",
                  "title": "{{c.Names}}",
                  "badge": "{{c.State}}",
                  "subtitle": "{{c.Status}}",
                  "actions": [
                    {
                      "label": {
                        "zh-Hans": "日志",
                        "en": "Logs"
                      },
                      "icon": "log",
                      "style": "tonal",
                      "onTap": {
                        "action": "run",
                        "template": "docker_logs",
                        "into": "action",
                        "args": {
                          "container": "{{item.Names}}",
                          "lines": "100"
                        }
                      }
                    },
                    {
                      "label": {
                        "zh-Hans": "重启",
                        "en": "Restart"
                      },
                      "icon": "restart",
                      "style": "tonal",
                      "onTap": {
                        "action": "run",
                        "template": "docker_restart",
                        "into": "action",
                        "args": {
                          "container": "{{item.Names}}"
                        }
                      }
                    },
                    {
                      "label": {
                        "zh-Hans": "停止",
                        "en": "Stop"
                      },
                      "icon": "stop",
                      "style": "danger",
                      "confirm": true,
                      "onTap": {
                        "action": "run",
                        "template": "docker_stop",
                        "into": "action",
                        "args": {
                          "container": "{{item.Names}}"
                        }
                      }
                    },
                    {
                      "label": {
                        "zh-Hans": "删除",
                        "en": "Remove"
                      },
                      "icon": "delete",
                      "style": "danger",
                      "confirm": {
                        "zh-Hans": "删除容器不可撤销（数据卷不受影响）。确定继续？",
                        "en": "Removing a container cannot be undone (volumes are kept). Continue?"
                      },
                      "onTap": {
                        "action": "run",
                        "template": "docker_rm",
                        "into": "action",
                        "args": {
                          "container": "{{item.Names}}"
                        }
                      }
                    }
                  ]
                }
              }
            ],
            "else": [
              {
                "type": "card",
                "title": {
                  "zh-Hans": "容器（原始输出）",
                  "en": "Containers (raw)"
                },
                "children": [
                  {
                    "type": "when",
                    "cond": "{{data.containers.ok}}",
                    "then": [
                      {
                        "type": "column",
                        "gap": "sm",
                        "children": [
                          {
                            "type": "text",
                            "value": "{{data.containers.stdout}}",
                            "mono": true,
                            "maxLines": 30
                          },
                          {
                            "type": "text",
                            "value": "Took {{data.containers.elapsedMs}} ms",
                            "color": "secondary"
                          }
                        ]
                      }
                    ],
                    "else": [
                      {
                        "type": "errorView",
                        "title": {
                          "zh-Hans": "执行失败",
                          "en": "Command failed"
                        },
                        "description": "{{data.containers.message}}"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "card",
        "title": {
          "zh-Hans": "镜像",
          "en": "Images"
        },
        "children": [
          {
            "type": "dataSource",
            "key": "images",
            "capability": "ssh.exec",
            "parse": "json",
            "args": {
              "template": "docker_images"
            }
          },
          {
            "type": "when",
            "cond": "{{data.images.parsed}}",
            "then": [
              {
                "type": "forEach",
                "list": "{{data.images.json}}",
                "item": "i",
                "emptyText": "No images.",
                "template": {
                  "type": "listItem",
                  "icon": "layers",
                  "title": "{{i.Repository}}:{{i.Tag}}",
                  "trailing": "{{i.Size}}"
                }
              }
            ],
            "else": [
              {
                "type": "card",
                "title": {
                  "zh-Hans": "镜像（原始输出）",
                  "en": "Images (raw)"
                },
                "children": [
                  {
                    "type": "when",
                    "cond": "{{data.images.ok}}",
                    "then": [
                      {
                        "type": "column",
                        "gap": "sm",
                        "children": [
                          {
                            "type": "text",
                            "value": "{{data.images.stdout}}",
                            "mono": true,
                            "maxLines": 30
                          },
                          {
                            "type": "text",
                            "value": "Took {{data.images.elapsedMs}} ms",
                            "color": "secondary"
                          }
                        ]
                      }
                    ],
                    "else": [
                      {
                        "type": "errorView",
                        "title": {
                          "zh-Hans": "执行失败",
                          "en": "Command failed"
                        },
                        "description": "{{data.images.message}}"
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "when",
        "cond": "{{data.action}}",
        "then": [
          {
            "type": "card",
            "title": {
              "zh-Hans": "最近一次操作",
              "en": "Last action"
            },
            "children": [
              {
                "type": "when",
                "cond": "{{data.action.ok}}",
                "then": [
                  {
                    "type": "column",
                    "gap": "sm",
                    "children": [
                      {
                        "type": "text",
                        "value": "{{data.action.stdout}}",
                        "mono": true,
                        "maxLines": 30
                      },
                      {
                        "type": "text",
                        "value": "Took {{data.action.elapsedMs}} ms",
                        "color": "secondary"
                      }
                    ]
                  }
                ],
                "else": [
                  {
                    "type": "errorView",
                    "title": {
                      "zh-Hans": "执行失败",
                      "en": "Command failed"
                    },
                    "description": "{{data.action.message}}"
                  }
                ]
              }
            ]
          }
        ]
      },
      {
        "type": "card",
        "title": {
          "zh-Hans": "操作提示",
          "en": "How to act"
        },
        "children": [
          {
            "type": "text",
            "value": "Swipe a container row left to see logs / restart / stop / remove.",
            "color": "secondary"
          },
          {
            "type": "button",
            "label": {
              "zh-Hans": "刷新列表",
              "en": "Refresh"
            },
            "onTap": {
              "action": "refresh"
            },
            "style": "tonal"
          }
        ]
      }
    ]
  }
}